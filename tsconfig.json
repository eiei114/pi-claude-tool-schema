{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": [
      "node",
      "bun"
    ],
    "allowImportingTsExtensions": true
  },
  "include": [
    "extensions/**/*.ts",
    "lib/**/*.ts",
    "tests/**/*.ts"
  ]
}
